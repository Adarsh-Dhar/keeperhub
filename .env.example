# --- KeeperHub ---
# Organization API key from app.keeperhub.com > Settings > API Keys (kh_ prefix)
KEEPERHUB_API_KEY=kh_xxxxxxxxxxxxxxxxxxxx
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# --- Gemini (the reasoning agent) ---
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-pro

# --- Target chain / position being guarded ---
# Base Sepolia
CHAIN_ID=84532
GUARDIAN_WALLET_ADDRESS=0x486049aCC7D8b840789fb58fd88bb207357C0480
# Health factor (scaled 1e18 on-chain, human-readable threshold here) below which the
# guardian will act. Aave liquidation happens at 1.0 — 1.5 gives buffer to react.
HEALTH_FACTOR_THRESHOLD=1.5
# Workflow ID created by setup:workflow script (Position Guardian — Aave V3)
GUARDIAN_WORKFLOW_ID=

# --- Aave Position Setup (Foundry/cast) ---
# RPC URL for Base Sepolia
BASE_RPC_URL=https://sepolia.base.org
# Private key for the wallet that will hold the Aave position
PRIVATE_KEY=0xyour_test_wallet_private_key

# Aave V3 Base Sepolia core contracts
AAVE_POOL_ADDRESS=0x8bAB6d1b75f19e9eD9fCe8b9BD338844fF79aE27
FAUCET=0xC959483DBa39aa9E78757139af0e9a2EDEb3f42D
DATA_PROVIDER=0xBc9f5b7E248451CdD7cA54e717a2BFe1F32b566b

# Reserve assets on Base Sepolia
USDC=0xba50Cd2A20f6DA35D788639E581bca8d0B5d4D5f
USDT=0x0a215D8ba66387DCA84B284D18c3B4ec3de6E54a
# Debt asset address (what you borrowed in Aave)
DEBT_ASSET_ADDRESS=0x0a215D8ba66387DCA84B284D18c3B4ec3de6E54a
# Collateral asset address (what you supplied in Aave)
COLLATERAL_ASSET_ADDRESS=0xba50Cd2A20f6DA35D788639E581bca8d0B5d4D5f
# Actual ERC20 token addresses for wallet balance checks (Aave underlying tokens)
WALLET_DEBT_ASSET_ADDRESS=0x0a215D8ba66387DCA84B284D18c3B4ec3de6E54a
WALLET_COLLATERAL_ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Amounts (in token decimals)
MINT_USDC_AMOUNT=100000000  # 100 USDC (6 decimals)
SUPPLY_USDC_AMOUNT=15000000  # 15 USDC (6 decimals) 
BORROW_USDT_AMOUNT=5000000000  # 5,000 USDT (6 decimals)

# --- Notifications (optional — used only if you wire a Discord/Telegram action
# into the KeeperHub workflow itself; this var is for the local console fallback) ---
DISCORD_WEBHOOK_URL=

# --- Marketplace / x402 consumer demo (Day 3 stretch) ---
# A SEPARATE small testnet wallet, funded with a little Base Sepolia USDC, used only
# to pay for calling the listed guardian workflow. Never reuse a wallet holding real funds.
X402_PAYER_PRIVATE_KEY=0xYourTestOnlyPrivateKey
GUARDIAN_WORKFLOW_SLUG=position-guardian-aave-v3
